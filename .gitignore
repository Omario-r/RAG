.obsidian/workspace.json
.obsidian/workspace-mobile.json
.DS_Store

# окружение и секреты
.env
.venv/
__pycache__/
*.pyc

# данные и артефакты экспериментов
data/
corpus/
*.qdrant-snapshot
.obsidian

# partner-docs/ — документация партнёра как есть. Не наш материал, и в нём
# внутренняя топология его контура: адреса машин, схема проброса GPU
# в Proxmox, указание на Qdrant без ключа. Лежит локально, в репозиторий
# не попадает. Наш разбор — в профильных документах волта, там адреса
# приводятся только там, где без них не объяснить.
partner-docs/

# настройки инструментов
# settings.json версионируется: это решение о том, что разрешено делать
# без спроса, и без истории оно через месяц выглядит произволом.
# Абсолютных путей и секретов в нём нет. Личные правки — в settings.local.json.
.claude/*
!.claude/settings.json
!.claude/skills/
*.fb2
